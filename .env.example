# Google AI Studio key (https://aistudio.google.com/apikey).
# Gemma 4 is served through the Gemini API, so this one key calls Gemma 4.
GEMINI_API_KEY=
# Gemma 4 model id. Run `python scripts/list_models.py` to see what your key can use.
#   gemma-4-26b-a4b-it  (default: MoE, ~4B active params, fastest for voice)
#   gemma-4-31b-it      (dense, higher quality, slower)
GEMMA_MODEL=gemma-4-26b-a4b-it
# Local bridge between the browser extension and the assistant (loopback only)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
# Shared secret the extension must send. Generate any random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
BRIDGE_TOKEN=
